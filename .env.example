# Copy to .env and adjust. Consumed by docker-compose.yml.

# Upstream release channel for Wolf and Wolf Den: stable or beta. Both run the
# Games-on-Whales images as published (ghcr.io/games-on-whales/wolf:<channel>,
# ghcr.io/games-on-whales/wolf-den:<channel>). The installer asks for this.
WOLF_CHANNEL=stable
# Pin either image to a tag or digest instead of following the channel:
#WOLF_IMAGE=ghcr.io/games-on-whales/wolf:stable
#WOLF_DEN_IMAGE=ghcr.io/games-on-whales/wolf-den:stable

# Port the Wolf Den UI is published on, on the Proxmox host itself.
WOLF_DEN_PORT=8080

# Proxmox CT id for the Wolf CT. The installer prompts for this, defaulting to
# the lowest id no guest in the cluster owns, and refuses one that is taken.
# Requires docker-lxc-daemon >= 0.1.3: older releases ignore this setting and
# can collide with a peer node's guests. Empty lets the fixed daemon allocate
# a free cluster-wide id. Session and image-template CTs use separate free ids;
# this value is not a lower bound or a reserved range for them.
WOLF_CTID=

# Static LAN IP for the Wolf CT, as CIDR — required for Moonlight/mDNS
# discovery. Must be free on your LAN and match the daemon's --lan-* bridge.
WOLF_LAN_IP=192.168.1.50/24

# Proxmox storage for the Wolf CT rootfs and every session CT.
DLD_STORAGE=local-lvm

# Wolf's state + per-app game data (Steam libraries) live under /etc/wolf, which
# the installer backs with a volume allocated from DLD_STORAGE via pvesm — the
# same on lvmthin, LVM, ZFS, dir or NFS, and independent of the Wolf container,
# so an image update cannot take the game library with it. Size it with
# WOLF_STATE_SIZE (GB) at install time; point WOLF_STATE_VOLUME at an existing
# volume id to adopt one instead of allocating. The installer writes both back
# here, and the uninstaller reads WOLF_STATE_VOLUME to know what it may free.
#WOLF_STATE_SIZE=100
#WOLF_STATE_VOLUME=local-lvm:vm-9000-wolf-state

# Wolf CT rootfs size (Steam library / game data). Games persist here, so give
# it room. Uses the DLD_STORAGE pool, never the OS root.
WOLF_DISK_SIZE=100G

# CT cores and RAM for Wolf itself; the installer prompts for both and writes
# them here (RAM takes a size suffix, e.g. 4096M / 8G). Leave them out entirely
# and the CT is uncapped — all host cores and RAM, the daemon's default.
# Session CTs are sized separately by Wolf.
WOLF_CPUS=4
WOLF_MEMORY=4096M

# DRM render node Wolf uses (vendor detection + virtual desktops). The installer
# lists the host's GPUs and writes your choice here. Find yours manually with:
#   ls -l /sys/class/drm/renderD*/device/driver
WOLF_RENDER_NODE=/dev/dri/renderD128
# Separate encoder node; leave empty to reuse the render node.
WOLF_ENCODER_NODE=

# Identity-mapped runtime dir (host == container path). Sockets Wolf mounts
# into session CTs resolve here on the host.
WOLF_RUNTIME_DIR=/run/wolf

# Which build of the GOW *app* images (firefox, steam, retroarch, xfce, ...) to
# run, plus the pulseaudio sidecar. This is not Wolf itself — Wolf and Wolf Den
# come from WOLF_CHANNEL above, and are unaffected by this.
#
#   edge   — Ubuntu-based, the tested default
#   fedora — Fedora-based (newer Mesa)
#
# The installer asks for this and writes your choice here. On NVIDIA, non-edge
# builds have been seen to fall back to llvmpipe software rendering, which Wolf's
# capture/encode pipeline cannot negotiate (black screen); switch back to 'edge'
# if that happens. Changing this, or anything else in this file, takes effect
# on the next `docker compose up -d` (a plain `docker restart` does not read
# .env): wolf-config-init.sh rewrites the image tags in config.toml on each start.
WOLF_IMAGE_TAG=edge

# Keyboard layout, locale and timezone inside the apps. Without them sessions
# come up with a US keyboard, English UI and UTC. The installer asks, defaulting
# to the host's own settings. On every start wolf-config-init.sh adds them to
# each docker app's env in config.toml (XKB_DEFAULT_LAYOUT, XKB_DEFAULT_VARIANT,
# LANG, LANGUAGE, TZ), including apps added later through Wolf Den. An app that
# sets one itself keeps its value. Leave a setting empty for the app's default.
WOLF_KEYBOARD=
WOLF_KEYBOARD_VARIANT=
WOLF_LOCALE=
WOLF_TZ=

# Proton's per-game log (steam-<appid>.log in the app's home under /etc/wolf),
# for debugging a game. Off when empty; 1 turns it on, or give a Wine debug
# channel list such as +seh,+timestamp. Leave it off otherwise: a game that
# throws in a loop can write tens of MB a second until /etc/wolf is full.
# Applied like the settings above, so an app that sets PROTON_LOG keeps it.
WOLF_PROTON_LOG=

WOLF_LOG_LEVEL=INFO
WOLF_STOP_CONTAINER_ON_EXIT=TRUE

# --- NVIDIA only (docker-compose.nvidia.yml) ---
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
